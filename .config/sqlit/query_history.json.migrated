  {
    "query": "SHOW COLUMNS FROM sio_llm___agent_assistant;",
    "timestamp": "2026-04-08T08:54:26.604409",
    "connection_name": "prod"
  },
  {
    "query": "SHOW TABLES LIKE '%agent_assistant%';",
    "timestamp": "2026-04-08T08:48:10.570340",
    "connection_name": "prod"
  },
  {
    "query": "-- Copy selected agents (+ their assistants) to a new tenant\n-- 1. Set target tenant ID\n-- 2. Add agent IDs to the @agent_ids list\n-- 3. Run the preview SELECTs first, then uncomment the INSERTs\n\nSET @target_tenant = '12a87f17-318a-4f0a-8bb4-214be1a75a50';\n\n-- Agent IDs to copy (comma-separated)\nSET @agent_ids = 'a94716cb-ec88-47cd-bab7-d2252c8f7f39';\n\n-- Create temp table from comma-separated IDs\nDROP TEMPORARY TABLE IF EXISTS tmp_agent_ids;\nCREATE TEMPORARY TABLE tmp_agent_ids (id CHAR(36) PRIMARY KEY);\nSET @sql = CONCAT(\n  'INSERT INTO tmp_agent_ids (id) VALUES (''',\n  REPLACE(@agent_ids, ',', '''),('''),\n  ''')'\n);\nPREPARE stmt FROM @sql;\nEXECUTE stmt;\nDEALLOCATE PREPARE stmt;\n\n-- Collect assistant IDs linked to selected agents\nDROP TEMPORARY TABLE IF EXISTS tmp_assistant_ids;\nCREATE TEMPORARY TABLE tmp_assistant_ids AS\n  SELECT DISTINCT assistant_id AS id\n  FROM sio_llm__agent_assistants\n  WHERE agent_id IN (SELECT id FROM tmp_agent_ids);\n\n-- ID mapping tables (old ID -> new UUID)\nDROP TEMPORARY TABLE IF EXISTS tmp_agent_map;\nCREATE TEMPORARY TABLE tmp_agent_map (\n  old_id CHAR(36) PRIMARY KEY,\n  new_id CHAR(36) NOT NULL\n);\nINSERT INTO tmp_agent_map (old_id, new_id)\n  SELECT id, UUID() FROM tmp_agent_ids;\n\nDROP TEMPORARY TABLE IF EXISTS tmp_assistant_map;\nCREATE TEMPORARY TABLE tmp_assistant_map (\n  old_id CHAR(36) PRIMARY KEY,\n  new_id CHAR(36) NOT NULL\n);\nINSERT INTO tmp_assistant_map (old_id, new_id)\n  SELECT id, UUID() FROM tmp_assistant_ids;\n\n-- =====================================================\n-- Preview\n-- =====================================================\nSELECT 'AGENTS' AS entity, a.id, a.name, m.new_id\n  FROM sio_llm__agent_entity a\n  JOIN tmp_agent_map m ON a.id = m.old_id;\n\nSELECT 'ASSISTANTS' AS entity, a.id, a.name, a.type, m.new_id\n  FROM sio_llm__agent_assistant a\n  JOIN tmp_assistant_map m ON a.id = m.old_id;\n\n-- =====================================================\n-- Copy (uncomment to run)\n-- =====================================================\n\n-- Agents\n-- INSERT INTO sio_llm__agent_entity\n--   (id, tenantId, name, llmConfig, description, imageId, instructions,\n--    isDefault, tools, inheritInstructions, inheritAssistants,\n--    useInstructionsAsPrompt, welcomeMessage, allowedManufacturerIds,\n--    createdAt, updatedAt)\n-- SELECT\n--   m.new_id, @target_tenant, a.name, a.llmConfig, a.description, a.imageId,\n--   a.instructions, 0, a.tools, a.inheritInstructions, a.inheritAssistants,\n--   a.useInstructionsAsPrompt, a.welcomeMessage, a.allowedManufacturerIds,\n--   NOW(), NOW()\n-- FROM sio_llm__agent_entity a\n-- JOIN tmp_agent_map m ON a.id = m.old_id;\n\n-- Agent hierarchy\n-- INSERT INTO sio_llm__agent_hierarchy_entity\n--   (id, tenantId, parentId, orderIndex, nodeType, createdAt, updatedAt)\n-- SELECT\n--   m.new_id, @target_tenant, NULL, h.orderIndex, h.nodeType, NOW(), NOW()\n-- FROM sio_llm__agent_hierarchy_entity h\n-- JOIN tmp_agent_map m ON h.id = m.old_id;\n\n-- Agent performance\n-- INSERT INTO sio_llm__agent_performance\n--   (id, agentId, hourlyWage, evaluationDescription, createdAt, updatedAt)\n-- SELECT\n--   UUID(), m.new_id, p.hourlyWage, p.evaluationDescription, NOW(), NOW()\n-- FROM sio_llm__agent_performance p\n-- JOIN tmp_agent_map m ON p.agentId = m.old_id;\n\n-- Assistants\n-- INSERT INTO sio_llm__agent_assistant\n--   (id, tenantId, name, description, type, paramsCredentialsEnc)\n-- SELECT\n--   m.new_id, @target_tenant, a.name, a.description, a.type, a.paramsCredentialsEnc\n-- FROM sio_llm__agent_assistant a\n-- JOIN tmp_assistant_map m ON a.id = m.old_id;\n\n-- Agent <-> Assistant join table (re-link with new IDs)\n-- INSERT INTO sio_llm__agent_assistants (agent_id, assistant_id)\n-- SELECT am.new_id, asm.new_id\n-- FROM sio_llm__agent_assistants j\n-- JOIN tmp_agent_map am ON j.agent_id = am.old_id\n-- JOIN tmp_assistant_map asm ON j.assistant_id = asm.old_id;\n\n-- MCP tools\n-- INSERT INTO sio_llm__mcp_tools\n--   (id, tenantId, assistantId, name, description, enabled, createdAt, updatedAt)\n-- SELECT\n--   UUID(), @target_tenant, m.new_id, t.name, t.description, t.enabled, NOW(), NOW()\n-- FROM sio_llm__mcp_tools t\n-- JOIN tmp_assistant_map m ON t.assistantId = m.old_id;\n\n-- Assistant insights\n-- INSERT INTO sio_llm__assistant_insight\n--   (id, tenantId, assistantId, insight)\n-- SELECT\n--   UUID(), @target_tenant, m.new_id, i.insight\n-- FROM sio_llm__assistant_insight i\n-- JOIN tmp_assistant_map m ON i.assistantId = m.old_id;\n\n-- Cleanup\nDROP TEMPORARY TABLE IF EXISTS tmp_agent_ids;\nDROP TEMPORARY TABLE IF EXISTS tmp_assistant_ids;\nDROP TEMPORARY TABLE IF EXISTS tmp_agent_map;\nDROP TEMPORARY TABLE IF EXISTS tmp_assistant_map;\n\n-- NOTE: isDefault is set to 0 for copied agents to avoid conflicts.\n-- NOTE: hierarchy parentId is set to NULL (copies are placed at root level).\n-- NOTE: paramsCredentialsEnc is copied as-is \u2014 works within the same environment.\n--       Cross-environment copies need credential re-entry.",
    "timestamp": "2026-04-08T08:44:23.502349",
    "connection_name": "prod"
